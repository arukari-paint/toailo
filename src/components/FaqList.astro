---
/**
 * よくある質問。質問は見出し（h3）、回答はその直後の段落という素直な構造にする。
 * 構造化データ（FAQPage）は呼び出し側のページで同じ配列から作る。
 */
import type { FaqItem } from '@/data/apps';
interface Props { items: FaqItem[]; headingLevel?: 'h3' | 'h4' }
const { items, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class="faq">
  {items.map((f) => (
    <section class="faq-item" data-reveal>
      <H class="faq-q"><span class="mark" aria-hidden="true">Q</span>{f.q}</H>
      <p class="faq-a">{f.a}</p>
    </section>
  ))}
</div>

<style>
  .faq { display: grid; gap: 12px; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px 22px; }
  .faq-q { display: flex; gap: 12px; font-size: 1.02rem; margin: 0 0 8px; }
  .mark { flex: none; display: inline-grid; place-items: center; width: 1.7em; height: 1.7em; border-radius: 50%; background: var(--accent-subtle); color: var(--accent-strong); font-size: 0.85rem; font-weight: 800; }
  .faq-a { margin: 0; padding-left: calc(1.7em * 0.85 / 1 + 12px); color: var(--text-secondary); }
</style>
